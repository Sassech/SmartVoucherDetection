# syntax=docker/dockerfile:1
# webapp — multi-stage build
# Stage 1: build Next.js standalone output
# Stage 2: runtime image con solo el output compilado

# ── builder ──────────────────────────────────────────────────────────────────
FROM node:22-alpine AS builder
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@latest --activate

# Dependencies first — cached unless lockfile changes
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

COPY . .

# API_BASE_URL se pasa como build arg; en prod apunta al servicio Docker
ARG API_BASE_URL=http://api:8000
ENV API_BASE_URL=${API_BASE_URL}
ENV CI=true
ENV NEXT_TELEMETRY_DISABLED=1

RUN pnpm run build

# ── runtime ───────────────────────────────────────────────────────────────────
FROM node:22-alpine AS runtime
WORKDIR /app

ENV NODE_ENV=production \
    PORT=3000 \
    HOSTNAME=0.0.0.0 \
    NEXT_TELEMETRY_DISABLED=1

RUN addgroup -S nextgroup && adduser -S nextuser -G nextgroup

COPY --from=builder --chown=nextuser:nextgroup /app/.next/standalone ./
COPY --from=builder --chown=nextuser:nextgroup /app/.next/static ./.next/static

USER nextuser
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
  CMD wget -qO- http://localhost:3000/ || exit 1

CMD ["node", "server.js"]
