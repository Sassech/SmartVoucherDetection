FROM python:3.12-slim
WORKDIR /app

# Non-root user + uv in one layer (S6471, S7031).
# Files are copied as root (S6504) — appuser can read/exec but not modify the image.
# The /app dir itself stays root-owned; only the uv cache dir needs to be writable.
RUN useradd -r -u 1000 -s /sbin/nologin -m -d /home/appuser appuser && \
    pip install uv

ENV UV_CACHE_DIR=/home/appuser/.cache/uv

# Explicit filenames — no glob (S6470).
COPY pyproject.toml uv.lock ./

RUN uv sync

# Explicit module list — no recursive COPY (S6470), mirrors Dockerfile.prod.
# In dev the docker-compose bind-mount overlays this at runtime.
COPY main.py celery_app.py database.py config.py ./
COPY models/       ./models/
COPY routers/      ./routers/
COPY schemas/      ./schemas/
COPY services/     ./services/
COPY tasks/        ./tasks/
COPY dependencies/ ./dependencies/
COPY alembic/      ./alembic/
COPY alembic.ini   ./alembic.ini

USER appuser

CMD ["uv", "run", "fastapi", "dev", "main.py", "--host", "0.0.0.0"]
