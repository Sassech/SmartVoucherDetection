# Stage 1: builder — export production requirements via uv
FROM python:3.12-slim AS builder
WORKDIR /build
RUN pip install uv
COPY pyproject.toml uv.lock ./
RUN uv export --no-dev --frozen -o requirements.txt
RUN pip install --no-cache-dir -r requirements.txt --target /app/deps

# Stage 2: runtime — minimal image, non-root user
FROM python:3.12-slim AS runtime
WORKDIR /app

# System dependencies required by python-magic, pdf2image and OpenCV
RUN apt-get update && apt-get install -y --no-install-recommends \
    libmagic1 \
    poppler-utils \
    libgl1 \
    && rm -rf /var/lib/apt/lists/*

# Copy installed packages from builder
COPY --from=builder /app/deps /app/deps
ENV PYTHONPATH=/app/deps

# Copy only the application source needed at runtime
COPY main.py celery_app.py database.py config.py ./
COPY models/       ./models/
COPY routers/      ./routers/
COPY schemas/      ./schemas/
COPY services/     ./services/
COPY tasks/        ./tasks/
COPY dependencies/ ./dependencies/

RUN useradd -r -u 1000 -s /sbin/nologin -m -d /home/appuser appuser && \
    mkdir -p /app/data/uploads && chown -R appuser:appuser /app/data
USER appuser

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1
CMD ["python", "-m", "gunicorn", "main:app", \
     "-k", "uvicorn.workers.UvicornWorker", \
     "-w", "4", "-b", "0.0.0.0:8000", "--timeout", "120"]
