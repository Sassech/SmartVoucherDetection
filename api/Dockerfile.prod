# syntax=docker/dockerfile:1

# Stage 1: builder — export production requirements via uv + install deps
FROM python:3.12-slim AS builder
WORKDIR /build

# Install uv (cache mount keeps the pip cache across builds)
RUN --mount=type=cache,target=/root/.cache/pip pip install uv

COPY pyproject.toml uv.lock ./
RUN uv export --no-dev --frozen -o requirements.txt

# Install deps to /app/deps — cache pip downloads between builds
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements.txt --target /app/deps

# Stage 2: runtime — minimal image, non-root user
FROM python:3.12-slim AS runtime
WORKDIR /app

# Reduce .pyc noise and make logs flush immediately
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/deps

# System dependencies — ordered before app code so this layer is cached
# as long as the package list doesn't change
RUN apt-get update && apt-get install -y --no-install-recommends \
    libmagic1 \
    poppler-utils \
    libgl1 \
    && rm -rf /var/lib/apt/lists/*

# Copy installed packages from builder
COPY --from=builder /app/deps /app/deps

# Non-root user setup (before copying app source — layer is stable)
RUN useradd -r -u 1000 -s /sbin/nologin -m -d /home/appuser appuser && \
    mkdir -p /app/data/uploads && chown -R appuser:appuser /app/data

# Copy only the application source needed at runtime (changes most often — last)
COPY main.py celery_app.py database.py config.py ./
COPY models/       ./models/
COPY routers/      ./routers/
COPY schemas/      ./schemas/
COPY services/     ./services/
COPY tasks/        ./tasks/
COPY dependencies/ ./dependencies/
# Alembic — needed by the migrate service (and harmless for the api/celery images)
COPY alembic/      ./alembic/
COPY alembic.ini   ./alembic.ini

USER appuser

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1
CMD ["python", "-m", "gunicorn", "main:app", \
     "-k", "uvicorn.workers.UvicornWorker", \
     "-w", "4", "-b", "0.0.0.0:8000", "--timeout", "120"]
