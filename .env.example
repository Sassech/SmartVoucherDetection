# ============================================================================
# SmartVoucherDetection — variables de entorno
# Copiá este archivo a `.env` y completá con valores reales (.env está en .gitignore).
# ============================================================================

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=smartvoucher
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_DB=smartvoucher
POSTGRES_PORT=5432

# URL completa para SQLAlchemy async (asyncpg).
# Para Alembic en modo sync se deriva en api/alembic/env.py.
DATABASE_URL=postgresql+asyncpg://smartvoucher:changeme_local_only@localhost:5432/smartvoucher

# --- Redis -------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- llama-server (gemma-4-E2B-it-qat) ----------------------------------------
# Levantado vía llama.cpp/gemma-4-E2B-it-qat.sh
LLAMA_SERVER_URL=http://localhost:9931
# Alias del modelo (matchea el `-a` del script de llama-server).
LLAMA_MODEL_ALIAS=gemma-4-E2B-it-qat
# Timeout total por request HTTP (segundos).
LLAMA_TIMEOUT_S=10
# Reintentos ante errores de red o 5xx (NO ante 4xx ni JSON inválido).
LLAMA_MAX_RETRIES=3

# --- JWT Auth (Fase 4) -------------------------------------------------------
# Generar con: openssl rand -hex 32
JWT_SECRET_KEY=dev-secret-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS (Fase 4) -----------------------------------------------------------
# Origen del webapp Next.js. Con allow_credentials=True NO puede ser "*".
WEBAPP_ORIGIN=http://localhost:3000

# --- Production Docker (Fase 6) ----------------------------------------------
# Directorio del host donde está el modelo gemma-4-E2B-it-qat (montado read-only en llama-server).
LLAMA_MODEL_DIR=/path/to/llama.cpp/gemma-4-E2B-it-qat
# Nombre del archivo GGUF dentro de LLAMA_MODEL_DIR.
LLAMA_MODEL_FILE=gemma-4-E2B-it-qat-UD-Q4_K_XL.gguf
# Orígenes permitidos para CORS en producción (JSON array).
CORS_ORIGINS=["https://app.yourdomain.com","https://api.yourdomain.com"]
# Clave secreta para JWT y sesiones — mínimo 32 caracteres.
# Generar con: openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-32-plus-character-string
